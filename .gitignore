# Mac OS
.DS_Store

# Local secrets
.env

# Editor-generated local history (e.g. VS Code/Copilot "Local History" extension) — can appear at any depth
.history/

# JetBrains IDE state
.idea/

# Feature Team Workspace Outputs
.claude/feature-workspace/

# Episodic memory store (roadmap L3.5). A queryable projection of records
# that ARE committed — run-state.json, run-events.jsonl and the typed stage
# documents under state/ are archived into docs/features/<name>/ — so deleting
# this file loses nothing that cannot be
# rebuilt by re-ingesting. A binary sqlite file in git would produce merge
# conflicts nobody can read, for data that is derived.
.claude/memory/
/features/

# Local blog publishing helpers (keep drafts tracked, keep API posting mechanism local)
scripts/publish-blog-posts.py
docs/blog-posts/publishing.md

# Legacy and Backups
*.bak
archive/

