{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/orieken/loom/shared/schemas/pattern-spec.schema.json",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Pattern spec schema version. This build reads 1."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "kebab-case name. It MUST match the file name without .pattern.yaml."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of this pattern."
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence: what the workflow achieves."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "The team or person who answers for this pattern."
    },
    "triggers": {
      "properties": {
        "keywords": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Literal phrases that suggest this pattern."
        },
        "intentPatterns": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Descriptions of the user intent this pattern serves."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "keywords",
        "intentPatterns"
      ],
      "description": "When an assistant should offer this pattern. Same keys as skill triggers."
    },
    "inputs": {
      "items": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$",
            "description": "lowerCamelCase name. Steps consume it by this name."
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "path",
              "enum",
              "list"
            ],
            "description": "One of the closed set of input types."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the value is, for the person or model that supplies it."
          },
          "required": {
            "type": "boolean",
            "description": "true when a run cannot start without the value. A required input has no default."
          },
          "values": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "The allowed values of an enum input. Only for type enum."
          },
          "default": {
            "description": "The value a run uses when none is supplied. It MUST match the type."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "type",
          "description"
        ]
      },
      "type": "array",
      "description": "Values that vary between runs of the workflow."
    },
    "preconditions": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "What MUST be true before the first step."
    },
    "steps": {
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "kebab-case id, unique in the spec."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the step does."
          },
          "executor": {
            "type": "string",
            "enum": [
              "tool",
              "skill",
              "human"
            ],
            "description": "Who runs the step: tool, skill or human."
          },
          "consumes": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "type": "array",
            "description": "Inputs or earlier step outputs this step reads, by name."
          },
          "produces": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]*$"
            },
            "type": "array",
            "description": "Names of the values this step makes for later steps."
          },
          "reason": {
            "type": "string",
            "enum": [
              "approval",
              "irreversible",
              "judgment-out-of-scope"
            ],
            "description": "Why a person runs the step. Required for a human step, and only for one."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "description",
          "executor"
        ]
      },
      "type": "array",
      "minItems": 1,
      "description": "The steps, in order. Version 1 is a linear list."
    },
    "verify": {
      "items": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "skill",
              "tool"
            ],
            "description": "skill or tool."
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "description": "The skill directory name or the registered MCP tool name."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "name"
        ]
      },
      "type": "array",
      "description": "Existing skills or MCP tools that check the result."
    },
    "provenance": {
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "hand-written",
            "mined"
          ],
          "description": "hand-written or mined."
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "approved",
            "forged",
            "retired"
          ],
          "description": "candidate, approved, forged or retired."
        },
        "evidence": {
          "properties": {
            "clusterId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$",
              "description": "The miner's cluster id."
            },
            "instanceCount": {
              "type": "integer",
              "minimum": 1,
              "description": "How many times the workflow was seen."
            },
            "repos": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "minItems": 1,
              "description": "Identifiers of the repositories it was seen in."
            },
            "firstSeen": {
              "type": "string",
              "format": "date",
              "description": "Date of the first instance, YYYY-MM-DD."
            },
            "lastSeen": {
              "type": "string",
              "format": "date",
              "description": "Date of the last instance, YYYY-MM-DD. Not before firstSeen."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "clusterId",
            "instanceCount",
            "repos",
            "firstSeen",
            "lastSeen"
          ],
          "description": "Required when source is mined."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "source",
        "status"
      ],
      "description": "Where this spec came from, and its lifecycle status."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "version",
    "intent",
    "owner",
    "triggers",
    "steps",
    "provenance"
  ],
  "title": "Pattern Spec",
  "description": "One repeatable workflow (pattern mining F2). Rules a JSON Schema cannot express: shared/contracts/pattern-spec-contract.md."
}
