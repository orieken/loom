{
  "//": "Opt-in IDE settings for contributors to this repo. Copy to .vscode/settings.json to enable schema-backed autocomplete and validation for agent, skill, and Knowledge Item frontmatter, and for pattern specs.",
  "//requires": "Red Hat YAML extension (redhat.vscode-yaml). The `yaml.schemas` block below is what turns the JSON schemas in shared/schemas/ into live editor feedback.",

  "yaml.schemas": {
    "./shared/schemas/agent-frontmatter.schema.json": ["shared/agents/*.md"],
    "./shared/schemas/skill-frontmatter.schema.json": ["shared/skills/*/SKILL.md"],
    "./shared/schemas/ki-frontmatter.schema.json": [
      "shared/knowledge/*.md",
      ".claude/knowledge/*.md"
    ],
    "./shared/schemas/pattern-spec.schema.json": [
      "shared/patterns/**/*.pattern.yaml",
      ".claude/patterns/*.pattern.yaml"
    ]
  }
}
